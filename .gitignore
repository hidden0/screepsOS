###############################################################################
#  Screeps – Node / TypeScript project
###############################################################################

###############
# Core output #
###############
dist/
build/
tsc-out/
.rpt2_cache/          # rollup-plugin-typescript2
*.tsbuildinfo         # TypeScript incremental cache
coverage/
.nyc_output/

#####################
# Dependencies & CI #
#####################
node_modules/
bower_components/
jspm_packages/
server/               # Screeps-server test data
# Uncomment the next two lines **only** if you don’t want lockfiles in Git
# yarn.lock
# package-lock.json

########
# Logs #
########
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.*.json         # Node diagnostic reports

##################
# Screeps config #
##################
screeps.json          # API tokens & upload targets
.env*                 # dotenv environment files
.screeps.*            # any other local creds (e.g. .screepsrc)

#####################
# Editor/IDE cruft  #
#####################
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cache/
.tmproj
.project
.settings
nbproject
*.sw[op]

#################
# OS artefacts  #
#################
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

##############
# Misc junk  #
##############
*.diff
*.orig
*.rej
*.zip
*.vi
*~
